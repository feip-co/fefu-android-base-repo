<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ru.fefu.activitytracker">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Activity">
        <activity
            android:name="java.ru.fefu.activitytracker.screens.welcome.WelcomeScreenActivity"
            android:exported="true">
            <intent-filter>
                <category android:name="android.intent.category.LAUNCHER"/>
                <action android:name="android.intent.action.MAIN"/>
            </intent-filter>
        </activity>
        <activity
            android:name="java.ru.fefu.activitytracker.screens.login.LoginScreenActivity"
            android:exported="true"/>
        <activity
            android:name="java.ru.fefu.activitytracker.screens.registration.RegistrationScreenActivity"
            android:exported="true"/>
    </application>

</manifest>